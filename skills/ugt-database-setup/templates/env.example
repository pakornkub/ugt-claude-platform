# Environment Variables — <project-name>
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# ─── Database (MS SQL Server) ─────────────────────────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://<db-host>:<db-port>;database=<db-name>;user=<db-user>;password=<db-password>;encrypt=true;trustServerCertificate=true"

# ─── Misc ────────────────────────────────────────────────────────────────────
# Set to "1" to skip env validation (e.g. frontend-only CI that lacks secrets)
# SKIP_ENV_VALIDATION=1
