# Environment Variables — leave-request (ระบบคำขอลา) — real values, NEVER commit.

# ─── 1. App + runtime (always) ───────────────────────────────────────────────
NEXT_PUBLIC_BASE_PATH=/leave-request-dev
NEXT_PUBLIC_APP_NAME=ระบบคำขอลา (DEV)
NEXT_PUBLIC_APP_URL=http://localhost:3000/leave-request-dev
APP_PORT=3000
NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── 2. Database — MS SQL Server (always) ────────────────────────────────────
DATABASE_URL="sqlserver://SQLDEV01:1433;database=LeaveRequest_DEV;user=CHANGE_ME_DB_USER;password=CHANGE_ME_DB_PASSWORD;encrypt=true;trustServerCertificate=true"

