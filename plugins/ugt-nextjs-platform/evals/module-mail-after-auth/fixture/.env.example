# Environment Variables — leave-request (ระบบคำขอลา)
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
#
# CANONICAL LAYOUT — every org project has these sections in this order, with
# these key names. Setup skills fill THEIR section in place (never append at
# the bottom); a module that is not installed keeps its header with no keys.
# Same order as the `environment:` block in docker-compose*.yml.
# Key names never change per library version — if a library wants another name,
# map it in lib/env.ts, don't rename the key here.

# ─── 1. App + runtime (always) ───────────────────────────────────────────────
# /<basePath> when served under a basePath (with leading slash), empty = domain root.
# prod: /leave-request · dev: /leave-request-dev
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_APP_NAME=ระบบคำขอลา
# Full URL incl. basePath — used for links and CI build args
# prod: https://apps.ugt.local/leave-request · dev: https://apps.ugt.local/leave-request-dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host port for docker compose (container port is always 3000). Not read by `next dev`.
# prod: 3000 · dev: 3001
APP_PORT=3000
# Org standard: always on. Keycloak/LDAP/SQL Server use internal-CA certs and
# the servers are a closed intranet. Disables TLS verification for the whole
# Node process — same value in docker-compose*.yml.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── 2. Database — MS SQL Server (always) ────────────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://SQLDEV01:1433;database=LeaveRequest;user=__DB_USER__;password=__DB_PASSWORD__;encrypt=true;trustServerCertificate=true"

# Shadow database — DEV ONLY, used by `prisma migrate dev` (never by
# `migrate deploy`). Needed because the app login on the shared org server has
# no CREATE DATABASE right, so Prisma cannot make one itself. Ask the DBA for an
# empty database on the dev server and point this at it — Prisma wipes it on
# every migrate dev, so it must never hold data.
# Delete this line if the dev login may create databases itself.
SHADOW_DATABASE_URL="sqlserver://SQLDEV01:1433;database=LeaveRequest_shadow;user=__DB_USER__;password=__DB_PASSWORD__;encrypt=true;trustServerCertificate=true"

# ─── 3. Auth (ugt-nextjs-auth-setup) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32 — different value per environment
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32
# REQUIRED — bare origin only, NO basePath. Better Auth picks the session-cookie
# name from this URL's scheme (https:// → __Secure- prefix); empty = redirect loop.
# prod + dev: https://apps.ugt.local
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted origins for CSRF protection — prod + dev: https://apps.ugt.local
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Org mail domains, FIRST = canonical. Emails from SSO/LDAP/HR are stored and
# shown on ube.co.th; Local accounts (external contractors) may use NEITHER.
ORG_EMAIL_DOMAINS=ube.co.th,ube.com

# Keycloak SSO (primary) — the project's own client in the org realm
# Redirect URIs registered on the client:
#   https://apps.ugt.local/leave-request/api/auth/callback/keycloak
#   https://apps.ugt.local/leave-request-dev/api/auth/callback/keycloak
KEYCLOAK_ISSUER=https://keycloak.example/realms/CHANGE_ME
KEYCLOAK_CLIENT_ID=leave-request
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# AD / LDAP (fallback when Keycloak is down) — bind as user@LDAP_DOMAIN (UPN),
# so LDAP_DOMAIN is the DNS domain (ube.co.th), not the NetBIOS name (UBE)
LDAP_URL=ldaps://ad.ube.co.th:636
LDAP_BASE_DN=DC=ube,DC=co,DC=th
LDAP_DOMAIN=ube.co.th

# ─── 4. Mail (ugt-nextjs-mail-setup) ─────────────────────────────────────────

# ─── 5. Upload (ugt-nextjs-upload-setup) ─────────────────────────────────────

# ─── 6. Project-specific ─────────────────────────────────────────────────────

# ─── 7. Misc ─────────────────────────────────────────────────────────────────
# Set to "1" to skip env validation (e.g. frontend-only CI that lacks secrets)
# SKIP_ENV_VALIDATION=1
