# ── File storage + virus scanning (ugt-nextjs-upload-setup) ─────────────────
# Mount point of the Docker volume INSIDE the container. Must match the compose
# volume target and be writable by uid 1001 (the `nextjs` user in the image).
# Never point this at ./public — that would serve files without any auth check.
STORAGE_ROOT=/app/storage

# Largest file accepted, in bytes. 25 MB default.
# Uploads go through a Route Handler, not a Server Action, so Next.js's 1 MB
# `serverActions.bodySizeLimit` does not apply — but a reverse proxy in front
# may have its own limit (nginx `client_max_body_size`), so raise both.
UPLOAD_MAX_BYTES=26214400

# clamd, reachable on the compose network. The app FAILS CLOSED: if the scanner
# cannot be reached, uploads are refused rather than accepted unscanned.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# First start of the clamav container loads its signature database and can take
# several minutes — until then this timeout is what users hit.
CLAMAV_TIMEOUT_MS=30000
