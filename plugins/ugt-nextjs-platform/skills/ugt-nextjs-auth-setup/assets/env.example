# Auth environment variables — merge into the project's .env.example / .env.local
# Placeholders: <project-name> = app slug, <base-path> = Next.js basePath (no leading slash
# in the cookie prefix; WITH leading slash in NEXT_PUBLIC_BASE_PATH),
# <keycloak-host> = the org's shared Keycloak host, <realm> = the org realm,
# <ldap-host> = AD server hostname, <company-domain> = e.g. company.co.th,
# <ad-base-dn> = full AD base DN, e.g. DC=example,DC=com

# ─── App ─────────────────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_BASE_PATH empty when the app is served at the domain root.
NEXT_PUBLIC_BASE_PATH=/<base-path>
NEXT_PUBLIC_APP_NAME=<project-name>
# Full URL incl. basePath — not read by the auth templates; used by CI build args
# (ugt-cicd-setup). Keep if doing CI, otherwise safe to remove.
NEXT_PUBLIC_APP_URL=http://localhost:3000/<base-path>

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32
# Bare origin only — NO basePath here. https:// origins switch the session cookie
# to the __Secure- prefix (see references/auth-flows.md).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted origins for CSRF protection
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ─── Keycloak SSO ──────────────────────────── [METHOD: SSO] ─────────────────
# One shared org Keycloak server — each project gets its OWN client in the org realm.
# See references/keycloak-client.md for how to request the client.
KEYCLOAK_ISSUER=https://<keycloak-host>/realms/<realm>
KEYCLOAK_CLIENT_ID=<project-name>
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ─── LDAP / Active Directory ───────────────── [METHOD: LDAP] ────────────────
# Prefer ldaps:// (TLS, port 636); plain ldap:// only on a private internal network.
LDAP_URL=ldaps://<ldap-host>
# Full base DN of the AD domain — one DC= component per domain label, e.g. DC=example,DC=com
LDAP_BASE_DN=<ad-base-dn>
LDAP_DOMAIN=<company-domain>

# ─── Internal-CA TLS (local/dev only) ────────── [METHOD: SSO or LDAP] ───────
# If the org's Keycloak/LDAP serves a cert from an internal CA, Node can't
# verify it and SSO fails with "Invalid OAuth configuration" (or LDAP bind
# fails). Preferred fix: mount the CA cert and set NODE_EXTRA_CA_CERTS instead.
# Last resort, LOCAL DEV ONLY — never uncomment in .env / .env.dev (the files
# that mirror what Jenkins deploys) and never in the production credential:
# it disables TLS certificate verification for the ENTIRE Node process.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Misc ────────────────────────────────────────────────────────────────────
# Set to "1" to skip env validation (e.g. frontend-only CI that lacks secrets).
# The Keycloak plugin registration in lib/auth.ts is guarded for this case.
# SKIP_ENV_VALIDATION=1
