# Auth environment variables — fill section "3. Auth" of the project's .env.example /
# .env.local in place (canonical layout: ugt-nextjs-database-setup/assets/env.example).
# NEXT_PUBLIC_BASE_PATH / NEXT_PUBLIC_APP_NAME / NEXT_PUBLIC_APP_URL and
# NODE_TLS_REJECT_UNAUTHORIZED live in section 1 — set the basePath there
# (WITH leading slash, e.g. /__BASE_PATH__; empty = domain root).
# Placeholders: __PROJECT_NAME__ = app slug, __KEYCLOAK_HOST__ = the org's shared Keycloak host, __REALM__ = the org realm,
# __LDAP_HOST__ = AD server hostname, __COMPANY_DOMAIN__ = e.g. company.co.th,
# __AD_BASE_DN__ = full AD base DN, e.g. DC=example,DC=com

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32
# REQUIRED — never leave this empty, especially in production. Bare origin only,
# NO basePath here. Better Auth picks the session-cookie name from this URL's
# scheme (https:// → the __Secure- prefix); with it empty it falls back to
# NODE_ENV, so a production deployment gets a cookie name that lib/actions/auth.ts
# does not compute → redirect loop (see references/auth-flows.md).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted origins for CSRF protection
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ─── Keycloak SSO ──────────────────────────── [METHOD: SSO] ─────────────────
# One shared org Keycloak server — each project gets its OWN client in the org realm.
# See references/keycloak-client.md for how to request the client.
KEYCLOAK_ISSUER=https://__KEYCLOAK_HOST__/realms/__REALM__
KEYCLOAK_CLIENT_ID=__PROJECT_NAME__
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ─── LDAP / Active Directory ───────────────── [METHOD: LDAP] ────────────────
# Prefer ldaps:// (TLS, port 636); plain ldap:// only on a private internal network.
LDAP_URL=ldaps://__LDAP_HOST__
# Full base DN of the AD domain — one DC= component per domain label, e.g. DC=example,DC=com
LDAP_BASE_DN=__AD_BASE_DN__
LDAP_DOMAIN=__COMPANY_DOMAIN__
