# Auth environment variables — merge into the project's .env.example / .env.local
# Placeholders: __PROJECT_NAME__ = app slug, __BASE_PATH__ = Next.js basePath (no leading slash
# in the cookie prefix; WITH leading slash in NEXT_PUBLIC_BASE_PATH),
# __KEYCLOAK_HOST__ = the org's shared Keycloak host, __REALM__ = the org realm,
# __LDAP_HOST__ = AD server hostname, __COMPANY_DOMAIN__ = e.g. company.co.th,
# __AD_BASE_DN__ = full AD base DN, e.g. DC=example,DC=com

# ─── App ─────────────────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_BASE_PATH empty when the app is served at the domain root.
NEXT_PUBLIC_BASE_PATH=/__BASE_PATH__
NEXT_PUBLIC_APP_NAME=__PROJECT_NAME__
# Full URL incl. basePath — not read by the auth templates; used by CI build args
# (ugt-cicd-setup). Keep if doing CI, otherwise safe to remove.
NEXT_PUBLIC_APP_URL=http://localhost:3000/__BASE_PATH__

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32
# REQUIRED — never leave this empty, especially in production. Bare origin only,
# NO basePath here. Better Auth picks the session-cookie name from this URL's
# scheme (https:// → the __Secure- prefix); with it empty it falls back to
# NODE_ENV, so a production deployment gets a cookie name that lib/actions/auth.ts
# does not compute → redirect loop (see references/auth-flows.md).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated trusted origins for CSRF protection
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ─── Keycloak SSO ──────────────────────────── [METHOD: SSO] ─────────────────
# One shared org Keycloak server — each project gets its OWN client in the org realm.
# See references/keycloak-client.md for how to request the client.
KEYCLOAK_ISSUER=https://__KEYCLOAK_HOST__/realms/__REALM__
KEYCLOAK_CLIENT_ID=__PROJECT_NAME__
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ─── LDAP / Active Directory ───────────────── [METHOD: LDAP] ────────────────
# Prefer ldaps:// (TLS, port 636); plain ldap:// only on a private internal network.
LDAP_URL=ldaps://__LDAP_HOST__
# Full base DN of the AD domain — one DC= component per domain label, e.g. DC=example,DC=com
LDAP_BASE_DN=__AD_BASE_DN__
LDAP_DOMAIN=__COMPANY_DOMAIN__

# ─── Internal-CA TLS ─────────────────────────── [METHOD: SSO or LDAP] ───────
# If the org's Keycloak/LDAP serves a cert from an internal CA, Node can't
# verify it and SSO fails with "Invalid OAuth configuration" (or LDAP bind
# fails). Preferred fix: mount the CA cert and set NODE_EXTRA_CA_CERTS instead.
# Default ON here because this project's containers sit on a closed intranet
# with no outbound path to the internet — it disables TLS certificate
# verification for the ENTIRE Node process, so remove this the moment the
# container can reach any external host (npm registry, external API, etc.).
NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Misc ────────────────────────────────────────────────────────────────────
# Set to "1" to skip env validation (e.g. frontend-only CI that lacks secrets).
# The Keycloak plugin registration in lib/auth.ts is guarded for this case.
# SKIP_ENV_VALIDATION=1
