# ── SMTP (ugt-nextjs-mail-setup) ────────────────────────────────────────────
# Ask the admin/DevOps team for these — they are in docs/admin-handoff.md.
# SMTP_HOST missing = sendMail throws on purpose. Never let it default to
# localhost:25: mail disappears with no error and nobody notices for weeks.
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=25
# true only for an implicit-TLS port (465). A relay on 25/587 with STARTTLS
# stays false — nodemailer upgrades by itself.
SMTP_SECURE=false
# Leave both blank for an internal relay that accepts unauthenticated mail from
# inside the network (the common corporate case).
SMTP_USER=
SMTP_PASS=
# Must be an address the relay is allowed to send AS, or it rejects the message.
SMTP_FROM=__SMTP_FROM__
