# .env.example — ugt-php-cicd-setup (committable template · ค่าจริงอยู่ .env / .env.dev ซึ่ง gitignore ทั้งคู่)
# compose อ่านไฟล์ .env ข้าง ๆ อัตโนมัติ (prod) · dev ต้องส่ง --env-file .env.dev เอง
# key เท่านั้น — ห้ามใส่ค่า secret จริงในไฟล์นี้

# host port ที่ compose ผูก (prod = __PORT_PROD__ · dev = __PORT_DEV__)
# container-internal คงที่ 80 เสมอ (apache) — ค่านี้คือฝั่ง host เท่านั้น
APP_PORT=

# [DB] ลบเมื่อโปรเจคไม่มีฐานข้อมูล
DATABASE_URL=

# [LARAVEL] Laravel ใช้ .env ไฟล์เดียวกันนี้เป็น config ของตัวแอปด้วย —
# สเตจ Deploy ส่งไฟล์นี้ต่อให้ `artisan migrate` ด้วย --env-file
# APP_KEY=
# APP_ENV=production
# APP_DEBUG=false
# DB_CONNECTION=
# DB_HOST=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# [WP] WordPress — ต้องประกาศใน `environment:` ของ compose ด้วย ไม่งั้น
# container ขึ้นมาแล้วไปหน้า install ใหม่ทุกครั้ง (SKILL §5.5)
# WORDPRESS_DB_HOST=
# WORDPRESS_DB_USER=
# WORDPRESS_DB_PASSWORD=
# WORDPRESS_DB_NAME=

# [SUBPATH] เมื่ออยู่หลัง reverse-proxy subpath (ดู SKILL §5.3) — ใช้ตัวที่ตรง shape แล้วลบที่เหลือ
# APP_URL=              # Laravel (URL เต็มรวม path) · คู่กับ ASSET_URL เมื่อ asset โดน proxy ตัด path
# ASSET_URL=            # Laravel
# app.baseURL=          # CodeIgniter 4 (ปิดท้ายด้วย /)
# WP_HOME=              # WordPress
# WP_SITEURL=           # WordPress

# secret อื่นที่แอปใช้จริง เพิ่ม key ที่นี่ (ค่าไปอยู่ .env/.env.dev)
