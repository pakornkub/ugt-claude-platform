# Org-standard PHP web Dockerfile — Laravel / CodeIgniter / plain PHP (apache)
#
# pin codename เสมอ ห้ามใช้ `php:8.3-apache` เปล่า — tag นั้นเลื่อนไป Debian
# trixie (13) แล้ว ซึ่งพัง Microsoft ODBC apt repo ที่บล็อก [DB] ข้างล่างต้องใช้
# สองชั้น: codename `debian/12` ไม่ตรงอีกต่อไป และ apt ของ trixie ไม่รับ key แบบ
# ASCII-armored ใน trusted.gpg.d (ยืนยันจาก build ที่ fail จริง — โปรเจค pilot 2026-08)
# หมายเหตุ: SQL Server ต้องการ PHP >= 8.3 เป็นเพดานแข็ง — PECL sqlsrv/pdo_sqlsrv
# รุ่นปัจจุบันตัดการรองรับ 8.2 ไปแล้ว ("pecl/sqlsrv requires PHP >= 8.3.0")
FROM php:8.3-apache-bookworm
WORKDIR /var/www/html

# [DB] เปิด extension ตาม DB ของโปรเจค — เลือกบรรทัดเดียว ลบที่เหลือ:
# RUN docker-php-ext-install pdo_mysql
# RUN pecl install sqlsrv pdo_sqlsrv && docker-php-ext-enable sqlsrv pdo_sqlsrv   # SQL Server (ต้องมี msodbcsql — ดู references/docker-deploy.md)

# curl ใช้โดย HEALTHCHECK ท้ายไฟล์ — base image ไม่มีมาให้ ต้องลงเองและ **ห้าม purge**
# (เดิมใช้ `php -r file_get_contents` เพื่อเลี่ยงการลง package แต่วิธีนั้นพังเงียบ
# เมื่อโปรเจคตั้ง `allow_url_fopen = Off` ตาม OWASP — ดู references §D)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && a2enmod rewrite

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock* ./
# legacy ที่ composer มีแต่ dev tooling: --no-dev จะไม่ติดตั้งอะไร — ถูกต้องแล้ว
# --no-scripts --no-autoloader: เลื่อน autoload-dump ไปหลัง COPY . . แทน —
# Laravel ผูก post-autoload-dump ไว้กับ `php artisan package:discover` ซึ่ง
# ต้องการ artisan (โค้ดแอป) ที่ยังไม่ถูก copy เข้ามาตอนนี้ รันตรงนี้จึง fail
# ทุกครั้ง เดิมเคยกลืน error นั้นไว้ด้วย `|| true` ซึ่งพา error จริงของ
# composer install (dependency resolve พัง ฯลฯ) หายไปด้วยเงียบ ๆ เหมือนกัน
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --no-autoloader

COPY . .
# regenerate autoloader ตอนนี้โค้ดแอปมาครบแล้ว — สำหรับ Laravel นี่คือจุดที่
# post-autoload-dump (package:discover) รันจริง ไม่มี --no-scripts แล้วรอบนี้
# ตั้งใจให้ fail ดังถ้า fail จริง · shape อื่นไม่มี hook นี้ ปลอดภัยเหมือนกัน
RUN composer dump-autoload --optimize --no-dev --no-interaction

# chown ปิดท้ายเสมอ — ต้องอยู่ "หลัง" dump-autoload ไม่ใช่ก่อน เพราะคำสั่งนั้น
# เขียน vendor/composer/autoload_*.php ใหม่ และ package:discover ของ Laravel
# เขียน bootstrap/cache/{packages,services}.php ทั้งหมดในนามของ root —
# chown ก่อนจะไม่ครอบไฟล์พวกนี้ แล้ว www-data เขียน bootstrap/cache ไม่ได้ตอนรัน
RUN chown -R www-data:www-data /var/www/html

# [LARAVEL] DocumentRoot ชี้ public/ — ลบ 2 บรรทัดนี้ถ้าไม่ใช่ Laravel/CI4
# RUN sed -ri 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/000-default.conf
# RUN sed -ri 's!/var/www/!/var/www/html/public!g' /etc/apache2/apache2.conf

EXPOSE 80

# 127.0.0.1 ห้าม localhost (บาง image resolve เป็น IPv6 ::1 แล้ว fail) · port 80
# คือพอร์ตในคอนเทนเนอร์เสมอ ไม่ใช่ host port
# **`-L` ห้ามตัดทิ้ง** — /api/health โดน 301 ได้สองทิศตรงข้ามกันแล้วแต่ shape:
#   Laravel (route + .htaccess มาตรฐาน) 301 ตัด `/` ท้ายทิ้ง
#   CI4/legacy/WordPress (ไฟล์ index.php) Apache 301 เติม `/` ท้ายเข้ามา
# `curl -f` ที่ไม่มี `-L` นับ 301 ว่า "สำเร็จ" → เขียวหลอกทั้งที่ข้างใต้อาจ 503
# มี `-L` แล้ว `-f` ตัดสินจาก status สุดท้าย = semantics เดียวกับ file_get_contents เดิม
# (ปลอดภัยเพราะ /api/health เป็น endpoint สาธารณะตาม contract ไม่ redirect ไปหน้า login)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS -L http://127.0.0.1:80/api/health || exit 1
