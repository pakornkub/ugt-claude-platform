# Org-standard WordPress Dockerfile — wp-content เป็น volume บังคับ (ดู compose)
FROM wordpress:php8.3-apache
# curl ใช้โดย HEALTHCHECK ข้างล่าง — ต้องลงเองและ **ห้าม purge** (เดิมใช้
# `php -r file_get_contents` ซึ่งพังเงียบเมื่อตั้ง `allow_url_fopen = Off` — ดู references §D)
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
# วาง org health endpoint ลง webroot ของ image (นอก wp-content — รอด volume mount)
COPY api/health/index.php /var/www/html/api/health/index.php
RUN chown -R www-data:www-data /var/www/html/api
# `-L` ห้ามตัดทิ้ง — WordPress เสิร์ฟ health เป็นไฟล์ `api/health/index.php`
# Apache จึง 301 เติม `/` ท้ายเข้ามา และ `curl -f` ที่ไม่มี `-L` นับ 301 ว่าสำเร็จ
# → เขียวหลอกทั้งที่ข้างใต้อาจ 503 (ดูตารางเทียบทุก shape ใน references §D)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS -L http://127.0.0.1:80/api/health || exit 1
