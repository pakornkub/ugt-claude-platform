# .env.example — ugt-python-cicd-setup (committable template · ค่าจริงอยู่ .env / .env.dev ซึ่ง gitignore ทั้งคู่)
# compose อ่านไฟล์ .env ข้าง ๆ อัตโนมัติ (prod) · dev ต้องส่ง --env-file .env.dev เอง
# key เท่านั้น — ห้ามใส่ค่า secret จริงในไฟล์นี้

# host port ที่ compose ผูก (prod = __PORT_PROD__ · dev = __PORT_DEV__)
APP_PORT=

# [DB] ลบเมื่อโปรเจคไม่มีฐานข้อมูล
DATABASE_URL=

# [SUBPATH] เมื่ออยู่หลัง reverse-proxy subpath (ดู SKILL §5.3) — ใช้ตัวที่ตรง framework แล้วลบที่เหลือ
# ROOT_PATH=            # FastAPI
# SCRIPT_NAME=          # Flask
# FORCE_SCRIPT_NAME=    # Django

# secret อื่นที่แอปใช้จริง เพิ่ม key ที่นี่ (ค่าไปอยู่ .env/.env.dev)
